<Window x:Class="Laboratorio05.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Laboratorio05"
        mc:Ignorable="d"
        Title="MainWindow" Height="700" Width="1600">
    <Grid Margin="10">
        <!-- Panel para el formulario de ingreso de cliente -->
        <StackPanel Orientation="Vertical" HorizontalAlignment="Left" Width="300">
            <Label Content="ID Cliente" Margin="0,0,0,5"/>
            <TextBox x:Name="txtIdCliente" Margin="0,0,0,5"/>

            <Label Content="Nombre Compañía" Margin="0,0,0,5"/>
            <TextBox x:Name="txtNombreCompania" Margin="0,0,0,5"/>

            <Label Content="Nombre Contacto" Margin="0,0,0,5"/>
            <TextBox x:Name="txtNombreContacto" Margin="0,0,0,5"/>

            <Label Content="Cargo Contacto" Margin="0,0,0,5"/>
            <TextBox x:Name="txtCargoContacto" Margin="0,0,0,5"/>

            <Label Content="Dirección" Margin="0,0,0,5"/>
            <TextBox x:Name="txtDireccion" Margin="0,0,0,5"/>

            <Label Content="Ciudad" Margin="0,0,0,5"/>
            <TextBox x:Name="txtCiudad" Margin="0,0,0,5"/>

            <Label Content="Región" Margin="0,0,0,5"/>
            <TextBox x:Name="txtRegion" Margin="0,0,0,5"/>

            <Label Content="Código Postal" Margin="0,0,0,5"/>
            <TextBox x:Name="txtCodPostal" Margin="0,0,0,5"/>

            <Label Content="País" Margin="0,0,0,5"/>
            <TextBox x:Name="txtPais" Margin="0,0,0,5"/>

            <Label Content="Teléfono" Margin="0,0,0,5"/>
            <TextBox x:Name="txtTelefono" Margin="0,0,0,5"/>

            <Label Content="Fax" Margin="0,0,0,5"/>
            <TextBox x:Name="txtFax" Margin="0,0,0,5"/>

            <!-- Botones para registrar y listar clientes -->
            <Button Content="Registrar" Click="btnRegistrar_Click" Margin="0,10,0,0" Width="100"/>
            <Button Content="Listar Clientes" Click="btnListar_Click" Margin="0,10,0,0" Width="100"/>
        </StackPanel>

        <!-- Título sobre el DataGrid -->
        <TextBlock Text="Lista de Clientes" FontSize="20" FontWeight="Bold" Margin="320,10,0,0"/>

        <!-- DataGrid para listar los clientes -->
        <DataGrid x:Name="dgClientes" AutoGenerateColumns="True" Margin="320,40,0,0"/>
    </Grid>
    
</Window>
